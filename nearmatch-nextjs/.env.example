# MongoDB connection string (local or Atlas).
# Local example:  mongodb://127.0.0.1:27017/nearmatch
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>/nearmatch?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nearmatch

# Secret used to sign merchant / admin JWTs. Change in production.
JWT_SECRET=nearmatch-dev-secret-change-me

# Owner dashboard credentials (demo defaults, override in production)
ADMIN_EMAIL=owner@nearmatch.app
ADMIN_PASSWORD=owner-demo

# Platform fee (INR) per redeemed deal
PLATFORM_FEE=25
